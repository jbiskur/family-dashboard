{
  "name": "heima",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:web": "bun run --filter @heima/web dev",
    "dev:api": "bun run --filter @heima/api dev",
    "build": "bun run --filter @heima/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests/http",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "test:setup": "bun scripts/test-setup.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "2.5.8",
    "@flowcore/time-uuid": "0.2.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.58.0",
    "@types/bun": "^1.3.10",
    "jose": "^6.1.3",
    "postgres": "^3.4.7",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "patchedDependencies": {
    "@flowcore/pathways@2.7.0": "patches/@flowcore%2Fpathways@2.7.0.patch"
  }
}
